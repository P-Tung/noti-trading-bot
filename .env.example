# Freqtrade local settings
FREQTRADE_USERDATA_DIR=./infra/freqtrade/user_data
FREQTRADE_CONFIG_PATH=./infra/freqtrade/config.json

# Supabase is the durable store for paper trading, reports, and decision audits.
# Keep secrets local and never commit a real value.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Claude candidate selection, server-only
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord bot, server-side only
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Dashboard server-side proxy
TRADE_BRAIN_URL=http://127.0.0.1:8090
TRADE_COLLECTION_INTERVAL_SECONDS=900
TRADE_QUOTE_INTERVAL_SECONDS=15
TRADE_PAPER_MODE=RESEARCH_PAPER
